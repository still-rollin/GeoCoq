% neurips_2024.sty — minimal self-contained shim approximating the NeurIPS look.
% Not the official style; provides enough for this preprint to compile offline.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/01/01 minimal NeurIPS shim]

\newif\if@neuripsnatbib\@neuripsnatbibtrue
\DeclareOption{final}{}
\DeclareOption{preprint}{}
\DeclareOption{nonatbib}{\@neuripsnatbibfalse}
\DeclareOption*{}
\ProcessOptions\relax

% Page geometry close to NeurIPS (US letter, ~5.5in text width).
\RequirePackage[letterpaper,left=1.5in,right=1.5in,top=1in,bottom=1in]{geometry}

% Bibliography.
\if@neuripsnatbib
  \RequirePackage{natbib}
\fi

% Paragraph style.
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5\baselineskip}

% Author block: \And separates author groups (used inside the standard \author).
\providecommand{\And}{\hspace{1.5em}}
\providecommand{\AND}{\\}

\endinput
